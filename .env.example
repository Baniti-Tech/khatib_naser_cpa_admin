# Admin auth (replace with real auth later)
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-long-random-string

# Google Cloud SQL (PostgreSQL) — fill after GCP setup
DATABASE_URL=postgresql://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# Local Cloud SQL Auth Proxy example:
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/khatib_cms

# Google Cloud Storage
GCS_BUCKET=khatib-naser-cpa-media
GCS_PROJECT_ID=your-gcp-project-id
# Path to service account JSON (local only; on Vercel use env JSON or Workload Identity)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# Public website (for preview links)
PUBLIC_SITE_URL=https://your-khatib-site.vercel.app

# Feature flags while GCP is not ready
USE_MOCK_DATA=true
